{
  "name": "dark-factory-dsh",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0 <27"
  },
  "scripts": {
    "preflight": "bash scripts/preflight.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/panel/tsconfig.json --noEmit",
    "lint": "bash scripts/discipline-lint.sh",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:verify": "bash scripts/verify.sh",
    "test:e2e": "vitest run e2e/cli",
    "test:docker": "FACTORY_TAGS=docker vitest run",
    "test:live": "FACTORY_TAGS=live vitest run",
    "test:e2e:panel": "playwright test",
    "build": "tsc -p tsconfig.build.json",
    "dogfood": "bash scripts/dogfood.sh",
    "panel": "node apps/panel/src/main.ts",
    "factory": "node apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "tsx": "4.23.15",
    "@playwright/test": "1.64.1"
  },
  "dependencies": {
    "commander": "15.0.0",
    "zod": "4.6.7",
    "pino": "10.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
